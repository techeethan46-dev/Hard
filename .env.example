# Only secrets go here (or in Render's Environment tab).
# Roles, channels, your Roblox game and group are chosen in Discord with /setup.

# --- Required ---
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=
# MongoDB connection string (Atlas: Database -> Connect -> Drivers)
MONGODB_URI=

# --- Optional ---
# Database name inside your cluster (default: roblox-bot)
MONGODB_DB=
# Only for testing: register commands on one server so changes show up instantly.
GUILD_ID=

# "Sign in with Roblox" verification. Leave blank to use the profile-code method.
# Create an app at https://create.roblox.com/dashboard/credentials (OAuth 2.0 Apps)
# with scopes "openid" + "profile" and redirect URL <your Render URL>/oauth/callback
BLOXLINK_API_KEY=
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Only needed off Render (Render's URL is detected automatically)
PUBLIC_URL=
PORT=3000
