# --- Required ---
# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (General Information page)
CLIENT_ID=
# Your server's ID (right-click server icon -> Copy Server ID, with Developer Mode on)
GUILD_ID=

# --- Your Roblox game ---
# The Place ID from your game's URL: roblox.com/games/<PLACE_ID>/...
ROBLOX_PLACE_ID=
# Optional: your Roblox group ID (enables rank -> role syncing, see config.json)
ROBLOX_GROUP_ID=

# --- Channels (IDs). Leave blank to disable that feature. ---
WELCOME_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=

# --- Tickets ---
# Category the ticket channels are created in
TICKET_CATEGORY_ID=
# Where transcripts of closed tickets are posted
TICKET_LOG_CHANNEL_ID=
# Roles that can see and handle tickets, comma-separated (members with Manage Server always can)
SUPPORT_ROLE_IDS=

# --- Roles (IDs) ---
# Given to everyone who links their Roblox account
VERIFIED_ROLE_ID=
# Optional: given to members who have NOT verified yet (removed on verify)
UNVERIFIED_ROLE_ID=

# --- "Sign in with Roblox" verification (optional, recommended) ---
# Register an OAuth app at https://create.roblox.com/dashboard/credentials (OAuth 2.0 Apps tab)
# with scopes "openid" and "profile", and redirect URL: <PUBLIC_URL>/oauth/callback
# If these are blank, /verify falls back to the profile-code method.
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Public HTTPS address where this bot's web server is reachable, e.g. https://mybot.example.com
PUBLIC_URL=
# Port the web server listens on
PORT=3000
